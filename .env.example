# Copy to .env (or set in your host's dashboard). All values are optional.
SITE_NAME=ClipFX
# used for share links & social previews
BASE_URL=https://clipfx.example.org
PORT=3000
# database + uploaded files live here — back it up!
DATA_DIR=./data
# enables secure cookies + HSTS
NODE_ENV=production
# set when behind nginx/Caddy/Cloudflare/Render/Fly
TRUST_PROXY=1
# per file
MAX_UPLOAD_MB=2048
MAX_PREVIEW_MB=250
# per member
USER_QUOTA_MB=25600
DONATE_URL=https://opencollective.com/your-project
CONTACT_EMAIL=hello@example.org
# these usernames become moderators on signup
ADMIN_USERNAMES=alice,bob
OPEN_SIGNUPS=true
# needs ffmpeg + ffprobe on PATH
MEDIA_PROCESSING=on
