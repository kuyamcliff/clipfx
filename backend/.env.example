# ClipFX API (Render). Copy to .env for local use, or set these in Render's dashboard.

# --- Required in production ---
# The website address. Used for share links and to allow requests from it.
BASE_URL=https://www.clipfx.me
# Developer pages are served on <username>.PAGES_DOMAIN (leave empty locally).
PAGES_DOMAIN=clipfx.me
# Any long random string; must match INTERNAL_SECRET on the website Worker. Lets the API trust the visitor IP it forwards.
INTERNAL_SECRET=change-me-to-a-long-random-string
NODE_ENV=production
TRUST_PROXY=1
# Cloudflare D1 (production): the clipfx-db Worker's URL and its DB_SECRET. See workers/db.
D1_URL=https://clipfx-db.your-subdomain.workers.dev
D1_SECRET=same-value-as-the-workers-DB_SECRET
# Or Postgres instead of D1 (used when D1_URL is empty), e.g. Supabase's session pooler (port 5432).
# Tables go in their own "clipfx" schema (not exposed by Supabase's REST API) with row-level security on.
# Leave unset to use SQLite in DATA_DIR (fine for local development, not for Render's temporary disk).
# DATABASE_URL=postgresql://postgres.yourproject:password@aws-0-us-east-2.pooler.supabase.com:5432/postgres
# DATABASE_SCHEMA=clipfx
# DATABASE_POOL_SIZE=5
# Temporary files (and the SQLite database when neither D1_URL nor DATABASE_URL is set).
DATA_DIR=/data

# --- Cloudflare R2 (files never pass through this server) ---
STORAGE=r2
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=r2-api-token-access-key
R2_SECRET_ACCESS_KEY=r2-api-token-secret
R2_BUCKET=clipfx
# Optional: override the endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
# R2_ENDPOINT=
# Optional: custom domains connected to the bucket (R2 → Settings → Custom Domains). When set, previews
# and downloads are served from them (cached by Cloudflare) instead of signed URLs. Note: a custom domain
# makes every object readable by anyone who has its URL. Keys are random, and removed assets are moved
# to new keys so shared links stop working.
R2_PUBLIC_IMAGE_URL=https://image.clipfx.me
R2_PUBLIC_VIDEO_URL=https://video.clipfx.me
R2_PUBLIC_AUDIO_URL=https://audio.clipfx.me
R2_PUBLIC_DOWNLOAD_URL=https://download.clipfx.me

# --- Optional ---
SITE_NAME=ClipFX
DONATE_URL=https://opencollective.com/your-project
CONTACT_EMAIL=hello@example.org
# These usernames become moderators when they sign up (the first account always does).
ADMIN_USERNAMES=
OPEN_SIGNUPS=true
MAX_UPLOAD_MB=2048
MAX_PREVIEW_MB=250
USER_QUOTA_MB=25600
# Files above this are uploaded in parts (min 5 MB on R2).
MULTIPART_THRESHOLD_MB=64
MIN_PART_MB=16
# Thumbnails/previews need ffmpeg (included in the Docker image).
MEDIA_PROCESSING=on

# Optional: "Continue with Google". In Google Cloud, add BASE_URL + /auth/google/callback
# (e.g. https://www.clipfx.me/auth/google/callback) as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: "Continue with GitHub". GitHub → Settings → Developer settings → OAuth Apps, with
# BASE_URL + /auth/github/callback (e.g. https://www.clipfx.me/auth/github/callback) as the callback URL.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Uploading without an account (on by default). Anonymous files get a private manage link.
ANON_UPLOADS=true
ANON_MAX_UPLOAD_MB=1024
