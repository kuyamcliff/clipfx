{
  "name": "clipfx-backend",
  "version": "2.0.0",
  "private": true,
  "description": "ClipFX JSON API: accounts, assets, moderation and signed upload/download URLs for Cloudflare R2.",
  "main": "src/server.js",
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/*.test.js\"",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "r2:cors": "node scripts/r2-cors.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1148.0",
    "@aws-sdk/s3-request-presigner": "^3.1148.0",
    "express": "^5.2.1",
    "pg": "^8.23.1"
  }
}
