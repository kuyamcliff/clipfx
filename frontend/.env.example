# ClipFX website (Vercel). Set these in Vercel → Project → Settings → Environment Variables.

# Your Render API address, no trailing slash.
BACKEND_URL=https://clipfx-api.onrender.com
# Must match INTERNAL_SECRET on the API.
INTERNAL_SECRET=change-me-to-a-long-random-string
# Optional: your public address, if you use a custom domain.
# PUBLIC_URL=https://clipfx.org
