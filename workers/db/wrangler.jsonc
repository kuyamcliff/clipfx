{
  // Database gateway for the API on Render. Deploy: npx wrangler deploy -c workers/db/wrangler.jsonc
  // Secret: npx wrangler secret put DB_SECRET -c workers/db/wrangler.jsonc  (same value as D1_SECRET on Render)
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "clipfx-db",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "clipfx", "database_id": "8cb4abb6-4be3-4a06-90ec-f697f014a6de" }
  ]
}
